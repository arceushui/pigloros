[Unit]
Description=Provision the Piglor Gateway Local Principal
Conflicts=piglor-gateway.service
Before=piglor-gateway.service

[Service]
Type=oneshot
User=pigloros
Group=pigloros
UMask=0077
StateDirectory=pigloros
StateDirectoryMode=0700
LoadCredentialEncrypted=pigloros.local-principal:/etc/credstore.encrypted/pigloros.local-principal.cred
ExecStart=/usr/bin/piglor-gateway provision-local-principal /var/lib/pigloros/gateway.db
NoNewPrivileges=yes
PrivateMounts=yes
PrivateNetwork=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/pigloros
