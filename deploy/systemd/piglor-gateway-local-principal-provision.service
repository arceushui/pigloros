[Unit]
Description=Provision the Piglor Gateway Local Principal
Conflicts=piglor-gateway.service
Before=piglor-gateway.service

[Service]
Type=oneshot
User=pigloros
Group=pigloros
UMask=0077
StateDirectory=pigloros
StateDirectoryMode=0700
LoadCredentialEncrypted=pigloros.local-principal:/etc/credstore.encrypted/pigloros.local-principal.cred
ExecStart=/usr/bin/piglor-gateway provision-local-principal /var/lib/pigloros/gateway.db
NoNewPrivileges=yes
PrivateMounts=yes
PrivateNetwork=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/pigloros
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
SystemCallArchitectures=native
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictAddressFamilies=AF_UNIX
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
