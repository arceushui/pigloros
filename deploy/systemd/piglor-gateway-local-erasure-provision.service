[Unit]
Description=Provision the Piglor Gateway Local erasure authority
Conflicts=piglor-gateway.service
Before=piglor-gateway.service

[Service]
Type=oneshot
User=pigloros
Group=pigloros
UMask=0077
StateDirectory=pigloros
StateDirectoryMode=0700
LoadCredentialEncrypted=pigloros.local-erasure-signer:/etc/credstore.encrypted/pigloros.local-erasure-signer.cred
LoadCredentialEncrypted=pigloros.release-trust:/etc/credstore.encrypted/pigloros.release-trust.cred
ExecStart=/usr/bin/piglor-gateway provision-local-erasure /var/lib/pigloros/gateway.db --issued-by erasure-bundle/local --signer-owner pigloros.local-erasure-signer --out /var/lib/pigloros/local-erasure-bundle.elb1
NoNewPrivileges=yes
PrivateMounts=yes
PrivateNetwork=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/pigloros
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
SystemCallArchitectures=native
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictAddressFamilies=AF_UNIX
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
