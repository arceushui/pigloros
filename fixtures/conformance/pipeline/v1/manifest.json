      "owner": "#504"
    },
    {
      "id": "R3-COMPOSITION-ANCHORED-PATH",
      "reason": "Rejecting a participant-bound Driver before anchored staging needs the same assignment; PCF-R3-001 covers only the AuthorityFenceRequired backstop",
      "owner": "#504"
    },
    {
      "id": "R3-COMPOSITION-MIXED-PASS",
      "reason": "Rejecting a mixed-profile host at composition needs the same assignment; PCF-R3-002 covers the runtime rule that one pass is one profile",
      "owner": "#504"
    },
    {
      "id": "R3-PARTICIPANT-COMMIT-RECOVERY",
      "reason": "Recovery and duplicate-receipt of a committed participant-authorized pass need a published participant authority fence in a store; the test host offers participant passes to a recording port only",
      "owner": "#507"
    },
    {
      "id": "REG-DUPLICATE-CLOSED-ERROR",
      "reason": "A type listed twice must fail with DuplicateEventTypeOwner on every path; the generated, pinned and test-support Driver paths reject it earlier with a binding error, so PCF-REG-002 pins only the rejection there",
      "owner": "#505"
    },
    {
      "id": "GATEWAY-HUMAN-SUCCESS-PATH",
      "reason": "Wave 8 has no installed Gateway action EPF1, so the authorized Gateway composition fails closed and its human success path is not publicly composable",
      "owner": "#461"
    },
    {
      "id": "COMMUNITY-PLUGIN-HOST",
      "reason": "Missing, invalid or over-budget governed Plugins and first-party versus community-replaceable parity need the ADR-061 community host",
      "owner": "#489"
    }
