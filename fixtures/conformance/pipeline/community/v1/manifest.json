    {
      "id": "COMMUNITY-RESERVED-PROPOSAL",
      "reason": "The real community guests emit only prototype.driven, so a community Driver's proposal of a reserved host Event type needs a new guest Component; this profile proves only the first-party refusal of that proposal and the refused reserved-type claim of either isolation class",
      "owner": "#636"
    },
    {
      "id": "DISCARD-FALLBACK-AND-AVAILABILITY",
      "reason": "Scheduled-pass discard without unrelated quarantine, no host domain fallback or retry, and missing, unavailable or invalid Plugins are not yet proven across isolation classes",
      "owner": "#633"
    },
    {
      "id": "OVER-BUDGET-PLUGIN",
      "reason": "Over-budget fail-closed behavior is not yet proven across isolation classes",
      "owner": "#634"
    },
    {
      "id": "REPLAY-AND-RECOVERY",
      "reason": "Replay without worker launches and lost-acknowledgement recovery of community Events are not yet proven",
      "owner": "#635"
    },
    {
      "id": "SQLITE-STORE",
      "reason": "The community pass world runs on MemoryStore only, so this profile proves no SQLite parity of the community path",
      "owner": "#489"
