#!/usr/bin/env bash
# PiglorOS pre-commit hook — fast local gates before commit.
# Install: git config core.hooksPath .githooks
set -euo pipefail

echo "pre-commit: cargo fmt --check"
cargo fmt --all -- --check

if ! command -v trunk >/dev/null 2>&1; then
    echo "pre-commit: Trunk is required for rust-test-policy; install it before committing" >&2
    exit 1
fi

echo "pre-commit: trunk rust-test-policy (staged files)"
trunk check --filter rust-test-policy --index --no-fix --no-progress

changed_files=$(git diff --cached --name-only --diff-filter=ACDMRT)
changed_cargo_manifests=$(printf '%s\n' "$changed_files" | awk '
    $0 == "Cargo.toml" || $0 ~ /\/Cargo\.toml$/
')
while IFS= read -r manifest; do
    [ -n "$manifest" ] || continue
    if [ "$manifest" = "fuzz/Cargo.toml" ]; then
        echo "pre-commit: cargo generate-lockfile --manifest-path $manifest"
        cargo generate-lockfile --manifest-path "$manifest"
        git add fuzz/Cargo.lock
    else
        echo "pre-commit: cargo generate-lockfile"
        cargo generate-lockfile
        git add Cargo.lock
    fi
done <<< "$changed_cargo_manifests"

# Include a generated lockfile in the metadata gate below when the command
# above added it to the index.
changed_files=$(git diff --cached --name-only --diff-filter=ACDMRT)
changed_rust_files=$(printf '%s\n' "$changed_files" | awk '$0 ~ /\.rs$/')
changed_cargo_files=$(printf '%s\n' "$changed_files" | awk '
    $0 == "Cargo.toml" || $0 == "Cargo.lock" || $0 == "rust-toolchain.toml" ||
    $0 ~ /\/Cargo\.toml$/ || $0 ~ /\/Cargo\.lock$/
')
if [ -z "$changed_rust_files" ] && [ -z "$changed_cargo_files" ]; then
    echo "pre-commit: no Rust or Cargo metadata staged; skipping clippy"
    echo "pre-commit: OK"
    exit 0
fi

echo "pre-commit: cargo clippy (changed packages)"
declare -A packages=()
declare -A isolated_manifests=()
needs_workspace=false
if [ -z "$changed_rust_files" ]; then
    needs_workspace=true
fi
package_name() {
    awk '
        /^\[package\][[:space:]]*$/ { in_package = 1; next }
        /^\[/ { in_package = 0 }
        in_package && /^[[:space:]]*name[[:space:]]*=/ {
            sub(/^[^=]*=[[:space:]]*/, "")
            gsub(/["[:space:]]/, "")
            print
            exit
        }
    ' "$1"
}

while IFS= read -r file; do
    case "$file" in
        fuzz/Cargo.toml|fuzz/Cargo.lock)
            isolated_manifests["fuzz/Cargo.toml"]="fuzz/Cargo.toml"
            ;;
    esac
done <<< "$changed_cargo_files"

while IFS= read -r file; do
    directory=$(dirname "$file")
    manifest=""
    while true; do
        if [ -f "$directory/Cargo.toml" ]; then
            manifest="$directory/Cargo.toml"
            break
        fi
        if [ "$directory" = "." ] || [ "$directory" = "/" ]; then
            break
        fi
        directory=$(dirname "$directory")
    done
    if [ -z "$manifest" ]; then
        needs_workspace=true
        continue
    fi
    manifest=${manifest#./}
    if [ "$manifest" = "fuzz/Cargo.toml" ]; then
        isolated_manifests["$manifest"]="$manifest"
        continue
    fi
    package=$(package_name "$manifest")
    if [ -n "$package" ]; then
        packages["$package"]="$manifest"
    else
        needs_workspace=true
    fi
done <<< "$changed_rust_files"

if [ "$needs_workspace" = true ] || [ "${#packages[@]}" -gt 5 ]; then
    echo "  (workspace-level clippy)"
    cargo clippy --workspace --all-features --all-targets --locked -- -D warnings -W clippy::pedantic
else
    for package in "${!packages[@]}"; do
        echo "  clippy: $package"
        cargo clippy -p "$package" --all-features --all-targets --locked -- -D warnings -W clippy::pedantic
    done
fi

for manifest in "${!isolated_manifests[@]}"; do
    echo "  clippy: $manifest"
    cargo clippy --manifest-path "$manifest" --all-targets --locked -- -D warnings -W clippy::pedantic
done

echo "pre-commit: OK"
